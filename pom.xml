    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <protobuf.version>4.32.1</protobuf.version>
        <grpc.version>1.68.0</grpc.version>
    </properties>

    <profiles>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <final.name>proto</final.name>
                <proto.includes>
                    */*.proto
                </proto.includes>
                <project.artifactId>x-platform-proto</project.artifactId>
            </properties>
        </profile>
        <profile>
            <id>user-manager</id>
            <properties>
                <final.name>user-manager</final.name>
                <proto.includes>
                    user-manager/*.proto
                </proto.includes>
                <project.artifactId>x-user-manager-proto</project.artifactId>
            </properties>
        </profile>
    </profiles>

